# Generated by owner binding. Credentials stay in the CLI's own auth storage.
FEISHU_APP_ID=
FEISHU_OWNER_OPEN_ID=
FEISHU_OWNER_CHAT_ID=

# Display and local identity. Quote values containing spaces.
BOT_NAME="AI 助手"
TIMEZONE=Asia/Shanghai
OWNER_PROFILE_PATH=.local/owner-profile.json
MESSAGE_SIGNATURE_TEMPLATE="AI 助手代发"
GROUP_WATCH_ACK_TEXT="收到，我会跟进这条消息。"

# One CLI for all AI tasks: claudecode | codex | grok. Missing defaults to codex.
AGENT_BACKEND=codex
CODEX_BIN=codex
GROK_BIN=grok
CLAUDECODE_BIN=claude
LARK_CLI_BIN=lark-cli
CODEX_MODEL=
GROK_MODEL=
CLAUDECODE_MODEL=
# Optional Claude native settings location; only auth, endpoint and model are read.
CLAUDECODE_SETTINGS_FILE=
# Exact extra destinations, comma-separated host[:port]. No wildcard or native fallback.
AGENT_NETWORK_ALLOWLIST=
# Advanced selected-backend maps; credentials remain local, never put values here.
AGENT_AUTH_FILES='{}'
AGENT_TIMEOUT_SECONDS=1800
AGENT_PROGRESS_FIRST_SECONDS=180
AGENT_PROGRESS_INTERVAL_SECONDS=180
AGENT_HISTORY_TURNS=10
EVOLUTION_ENABLED=false

# Optional skill repository. Local checkout is always .project/skills.
# An empty branch follows the remote default branch. No default repository.
SKILLS_REPO_ENABLED=false
SKILLS_REPO_URL=
SKILLS_REPO_BRANCH=

# Optional GitLab features. Configure your own host and authenticate glab locally.
GITLAB_SKILL_ENABLED=false
GLAB_BIN=glab
GITLAB_HOST=
ISSUE_SKILL_ENABLED=false
WORKDAY_MODE=weekdays
WORKDAY_CALENDAR_FILE=
ISSUE_SUMMARY_TIME=09:00
ISSUE_WATCH_START_TIME=09:00
ISSUE_WATCH_END_TIME=21:00
ISSUE_WATCH_INTERVAL_SECONDS=600

GROUP_WATCH_SKILL_ENABLED=false
GROUP_WATCH_POLL_SECONDS=30

# Local reports need no GitLab. Publishing additionally requires GitLab.
REPORT_SKILL_ENABLED=false
REPORT_PUBLISH_ENABLED=false
REPORT_PAGES_REPO_URL=
REPORT_PAGES_BRANCH=main

# Monitoring and publication are separate. There is no default repository.
PIPELINE_MONITOR_ENABLED=false
PIPELINE_PUBLISH_ENABLED=false
PIPELINE_PAGES_REPO_URL=
PIPELINE_PAGES_BRANCH=main
